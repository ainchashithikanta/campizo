# ==============================================================================
# College Hub Environment Configuration Template (v1.0.0)
# Copy to `.env` for local development. Never commit `.env` containing production secrets!
# ==============================================================================

# Application Lifecycle & Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug
GRACEFUL_SHUTDOWN_TIMEOUT_MS=30000
# Worker health server port (used by the background worker image / k8s probes)
WORKER_HEALTH_PORT=4100

# PostgreSQL Database (Primary ACID Store with Row Level Security & Pgvector)
POSTGRES_USER=collegehub_user
POSTGRES_PASSWORD=collegehub_password
POSTGRES_DB=collegehub_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://collegehub_user:collegehub_password@localhost:5432/collegehub_db?sslmode=disable
DATABASE_MAX_CONNECTIONS=20

# Redis Cache, Sessions, & Queue Cluster
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Security & Authentication
JWT_SECRET=super-secret-jwt-token-key-minimum-32-characters-long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
ENCRYPTION_KEY_32_BYTES=0123456789abcdef0123456789abcdef

# Object Storage Provider (Local MinIO / AWS S3 / Cloudflare R2)
STORAGE_PROVIDER=local
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=collegehub-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Notification & Email Provider (Mock / Mailpit / Firebase)
NOTIFICATION_PROVIDER=mock
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
SMTP_HOST=localhost
SMTP_PORT=1025
FIREBASE_CREDENTIALS_JSON=

# Search Provider (Postgres / Typesense / Meilisearch)
SEARCH_PROVIDER=postgres
TYPESENSE_API_KEY=
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108

# AI Provider Interface (OpenAI / Local Ollama)
AI_PROVIDER=mock
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# CORS & Domain Boundaries
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_DOMAIN=localhost

# ==============================================================================
# Backup & Disaster Recovery (MS-57)
# The backup CLI falls back to S3_*/DATABASE_URL/REDIS_URL when the BACKUP_*
# variables below are absent, so local backups work with zero extra config.
# Optional overrides (all documented in docs/ms-57-backup-and-disaster-recovery.md):
# BACKUP_PROVIDER=s3
# BACKUP_S3_ENDPOINT=http://localhost:9000
# BACKUP_S3_BUCKET=collegehub-backups
# BACKUP_S3_ACCESS_KEY_ID=minioadmin
# BACKUP_S3_SECRET_ACCESS_KEY=minioadmin
# BACKUP_PREFIX=collegehub-dev
# BACKUP_RETENTION_FULL_BACKUPS=7
# BACKUP_RETENTION_WAL_HOURS=72
# BACKUP_RETENTION_REDIS_SNAPSHOTS=3
# BACKUP_RETENTION_MINIO_MIRRORS=7
# ==============================================================================
