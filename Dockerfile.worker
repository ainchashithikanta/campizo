# Stage 1: Build Workspace
FROM node:20-alpine AS builder

WORKDIR /app
RUN npm install -g pnpm@9.1.0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.json ./
COPY apps/ ./apps/
COPY modules/ ./modules/
COPY packages/ ./packages/

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @college-hub/worker... build

# Stage 2: Production Worker Runner
FROM node:20-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV WORKER_HEALTH_PORT=4100

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 workeruser

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --from=builder --chown=workeruser:nodejs /app/apps/worker ./apps/worker
COPY --from=builder --chown=workeruser:nodejs /app/modules ./modules
COPY --from=builder --chown=workeruser:nodejs /app/packages ./packages
COPY --from=builder --chown=workeruser:nodejs /app/node_modules ./node_modules

USER workeruser

EXPOSE 4100

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:4100/health/live || exit 1

CMD ["node", "apps/worker/dist/index.js"]
