      "targets": [
        {
          "expr": "topk(10, sum by (query_hash, query_prefix) (increase(collegehub_db_slow_queries_total[$__range])))",
          "legendFormat": "{{query_prefix}}",
          "refId": "A"
        }
      ],
      "title": "Slow Queries (top 10 by hash)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
