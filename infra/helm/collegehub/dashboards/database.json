  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "showPoints": "never" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(collegehub_db_query_duration_seconds_bucket[$__rate_interval])) by (le, result))",
          "legendFormat": "p50 {{result}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(collegehub_db_query_duration_seconds_bucket[$__rate_interval])) by (le, result))",
          "legendFormat": "p99 {{result}}",
          "refId": "B"
        }
      ],
      "title": "Query Duration (p50 / p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "showPoints": "never" },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "expr": "sum(rate(collegehub_db_query_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "queries/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(collegehub_db_query_errors_total[$__rate_interval]))",
          "legendFormat": "errors/s",
          "refId": "B"
        }
      ],
      "title": "Query Throughput & Errors",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
