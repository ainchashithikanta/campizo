{
  "version": 2,
  "installCommand": "pnpm install --prod=false",
  "buildCommand": "pnpm exec turbo run build --filter=@college-hub/api...",
  "functions": {
    "api/index.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
