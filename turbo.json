{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.local"],
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "HOST",
    "LOG_LEVEL",
    "SERVICE_NAME",
    "BETTERSTACK_SOURCE_TOKEN",
    "BETTERSTACK_INGESTING_HOST",
    "RESEND_API_KEY",
    "MAIL_FROM",
    "MAIL_FROM_NAME",
    "APP_URL",
    "DATABASE_URL",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "POSTGRES_DB",
    "POSTGRES_PORT",
    "DATABASE_MAX_CONNECTIONS",
    "REDIS_PORT",
    "REDIS_URL",
    "REDIS_PASSWORD",
    "JWT_SECRET",
    "JWT_EXPIRES_IN",
    "REFRESH_TOKEN_EXPIRES_IN",
    "ENCRYPTION_KEY_32_BYTES",
    "STORAGE_PROVIDER",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_STORAGE_BUCKET_AVATARS",
    "SUPABASE_STORAGE_BUCKET_MARKETPLACE",
    "SUPABASE_STORAGE_BUCKET_MATERIALS",
    "SUPABASE_STORAGE_BUCKET_DOCUMENTS",
    "SUPABASE_STORAGE_BUCKET_EVENTS",
    "SUPABASE_STORAGE_BUCKET_MISC",
    "NOTIFICATION_PROVIDER",
    "SMTP_HOST",
    "SMTP_PORT",
    "SEARCH_PROVIDER",
    "AI_PROVIDER",
    "ALLOWED_ORIGINS",
    "COOKIE_DOMAIN",
    "MAILPIT_UI_PORT",
    "MAILPIT_SMTP_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
