{
  "name": "college-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Production-Grade Multi-College Modular Monolith Platform",
  "author": "College Hub Engineering Team",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "start": "node apps/api/dist/server.js",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,css}\"",
    "verify": "node scripts/verify-build.js",
    "release": "node scripts/generate-sbom.js",
    "db:up": "node scripts/infra-up.js",
    "db:down": "node scripts/infra-down.js",
    "db:status": "node scripts/infra-status.js",
    "infra:lint": "helm lint infra/helm/collegehub",
    "infra:render": "node scripts/render-manifests.js",
    "infra:template": "node scripts/render-manifests.js",
    "infra:validate": "node scripts/render-manifests.js && node scripts/validate-manifests.js",
    "backup": "turbo run build --filter=@college-hub/backup && node packages/backup/dist/cli.js",
    "backup:create": "pnpm backup run-all",
    "backup:verify": "pnpm backup verify",
    "backup:list": "pnpm backup list",
    "backup:cleanup": "pnpm backup cleanup",
    "backup:drill": "bash scripts/dr-restore-test.sh",
    "security:audit": "node scripts/run-security-audit.js",
    "load:test": "node scripts/run-load-test.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.0.14",
    "typescript": "^5.5.4"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "find-my-way": "^9.7.0",
      "fast-uri": "^3.1.2",
      "sharp": "^0.35.0",
      "vite": "^5.4.0"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {}
}
